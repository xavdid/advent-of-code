set quiet

# make installed binaries available at the top level
export PATH := "./node_modules/.bin:" + env('PATH')

_default:
	just --list

dev:
	astro dev

# general purpose handler for anstro commands
astro *options="":
	astro {{options}}

# to any checks to ensure the site is ready to go
validate:
	astro check
# don't need to test, since the only test so far is for an unused function
# just test
# eslint?

[no-exit-message]
lint-check:
    eslint .
    prettier --check src --log-level error

# fix issues checks
[no-exit-message]
lint:
    eslint . --fix
    prettier src --write --log-level error

# do a production build
build: validate
	astro build

test:
  vitest run

test-watch:
  vitest watch
